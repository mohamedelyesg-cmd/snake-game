from turtle import Turtle
import random
class Food(Turtle):
    def __init__ (self):
        super().__init__()
        self.shape("circle")
        self.color("red")
        self.shapesize(0.5,0.5)
        self.penup()
    def change_place(self):
        self.goto(random.randint(-320,320),random.randint(-320,320))
