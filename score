from turtle import Turtle
class Score(Turtle):
    def __init__ (self):
        super().__init__()
        self.score=0
        self.hideturtle()
        self.color("black")
        self.penup()
        self.goto(0,324)
    def writing(self):
        self.clear()
        self.write(self.score,font=("arial",19,"normal"),align="center")
    def game_over(self):
        self.screen.bgcolor("dark red")
        self.color("white")
        self.goto(0,0)
        self.write(f"Game over!!\nYour Score: {self.score}",font=("arial",30,"normal"),align="center")
        
