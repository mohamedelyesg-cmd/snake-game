from turtle import Turtle
class Scor():
    def __init__(self,position):
        with open("score.txt") as file:
            content=file.read()
        self.best_score=int(content)
        self.score=0
        self.turtle=Turtle()
        self.turtle.hideturtle()
        self.turtle.penup()
        self.turtle.color("black")
        self.turtle.goto(position)
    def display(self):
        self.turtle.clear()
        self.turtle.write(f"Score: {self.score}       Best Score: {self.best_score}",font=("arial",20,"normal"),align="center")
    def game_over(self):
        self.turtle.goto(0,0)
        if self.score>self.best_score:
            with open("score.txt","w") as file:
                file.write(str(self.score))
        self.turtle.screen.bgcolor("dark red")
        self.turtle.write(f"You lost!\nScore: {self.score}\nBest Score: {self.best_score}",font=("arial",20,"normal"),align="center")
