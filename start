from turtle import Screen
from time import *
from snake import Snake
from food import Food
from scor import Scor
game_on=True
window=Screen()
window.setup(700,700)
window.bgcolor("green")
window.listen()
window.tracer(0)
sam=Snake()
apple=Food()
s=Scor((0,320))
s.display()
window.onkey(sam.up,"Up")
window.onkey(sam.down,"Down")
window.onkey(sam.left,"Left")
window.onkey(sam.right,"Right")
while game_on:
    window.update()
    sleep(0.1)
    for sn in range(1,len(sam.snakes)):
        if sam.snakes[0].distance(sam.snakes[sn])<=18:
            game_on=False
    if sam.snakes[0].xcor()>=325 or sam.snakes[0].xcor()<=-325 or sam.snakes[0].ycor()>=325 or sam.snakes[0].ycor()<=-325:
        game_on=False
    if sam.snakes[0].distance(apple)<=22:
        s.score+=1
        s.display()
        apple.go()
        sam.change()
    sam.move()
s.game_over()
window.exitonclick()
