from turtle import Screen
import time
from food import Food
from score import Score
from snake import Snake
game_on=True
window=Screen()
window.bgcolor("green")
window.setup(700,700)
window.title("Snake game")
window.tracer(0)
sam=Snake()
apple=Food()
tom=Score()
apple.change_place()
window.listen()
window.onkey(sam.up,"Up")
window.onkey(sam.down,"Down")
window.onkey(sam.left,"Left")
window.onkey(sam.right,"Right")
while game_on:
    window.update()
    time.sleep(0.1)
    tom.writing()
    sam.move()
    if sam.head.xcor()>=340.01 or sam.head.xcor()<=-340.01 or sam.head.ycor()>=340.01 or sam.head.ycor()<=-340.01 :
        game_on=False
        tom.game_over()
    if apple.distance(sam.head)<=21:
        apple.change_place()
        sam.be_bigger()
        tom.score+=1
    for t in sam.turtles[:-1]:
        if sam.head.distance(t)<10:
            game_on=False
            tom.game_over()

    
window.exitonclick()
