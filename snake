from turtle import Turtle
class Snake:
    def __init__(self):
        self.snakes=[]
        self.position=((0,0),(-20,0),(-40,0))
        self.make_snake()
        self.snakes[0].color("orange")
    def make_snake(self):
        for p in self.position:
            turtle=Turtle("square")
            turtle.color("yellow")
            turtle.penup()
            turtle.goto(p)
            self.snakes.append(turtle)
    def move(self):
        for s in range(len(self.snakes)-1,0,-1):
            self.snakes[s].goto(self.snakes[s-1].pos())
        self.snakes[0].forward(20)
    def up(self):
        if self.snakes[0].heading()!=270:
            self.snakes[0].setheading(90)
    def down(self):
        if self.snakes[0].heading()!=90:
            self.snakes[0].setheading(270)
    def right(self):
        if self.snakes[0].heading()!=180:
            self.snakes[0].setheading(0)
    def left(self):
        if self.snakes[0].heading()!=0:
            self.snakes[0].setheading(180)
    def change(self):
        turtle=Turtle("square")
        turtle.color("yellow")
        turtle.penup()
        self.snakes.append(turtle)
        turtle.goto(self.snakes[-1].xcor()-20,self.snakes[-1].ycor()-20)
