from turtle import Turtle
class Snake:
    def __init__ (self):
        self.turtles=[]
        self.position=[(-40,0),(-20,0),(0,0)]
        self.make_snake()
        self.head=self.turtles[-1]
        self.head.color("orange")
    def make_snake(self):
        for x in self.position:
            turtle=Turtle("square")
            turtle.color("yellow")
            turtle.penup()
            turtle.goto(x)
            self.turtles.append(turtle)
    def move(self):
        for t in range(len(self.turtles)-1):
            self.turtles[t].goto(self.turtles[t+1].pos())
        self.head.forward(20)
    def up(self):
        self.head.setheading(90)
    def down(self):
        self.head.setheading(270)
    def left(self):
        self.head.setheading(180)
    def right(self):
        self.head.setheading(0)
    def be_bigger(self):
        new_turtle=Turtle("square")
        new_turtle.color("yellow")
        new_turtle.penup()
        new_turtle.goto(self.turtles[0].pos())
        self.turtles.insert(0,new_turtle)
